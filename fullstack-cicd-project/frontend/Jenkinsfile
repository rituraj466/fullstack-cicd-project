
pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Validate Frontend') {
            steps {
                dir('fullstack-cicd-project/frontend') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                sh 'docker build -t fullstack-frontend:latest fullstack-cicd-project/frontend'
            }
        }

        stage('Deploy Frontend') {
            steps {
                sh 'docker compose -p fullstack -f fullstack-cicd-project/docker-compose.yml up -d --no-deps frontend'
            }
        }
    }

    post {
        success {
            echo 'Frontend pipeline completed successfully!'
        }
        failure {
            echo 'Frontend pipeline failed. Check the console output.'
        }
    }
}
