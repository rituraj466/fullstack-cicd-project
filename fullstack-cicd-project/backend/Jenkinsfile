
pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test Backend') {
            steps {
                dir('fullstack-cicd-project/backend') {
                    sh 'npm install'
                    sh 'npm test'
                }
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                sh 'docker build -t fullstack-backend:latest fullstack-cicd-project/backend'
            }
        }

        stage('Deploy Backend') {
            steps {
                sh 'docker compose -p fullstack -f fullstack-cicd-project/docker-compose.yml up -d --no-deps backend'
            }
        }
    }

    post {
        success {
            echo 'Backend pipeline completed successfully!'
        }
        failure {
            echo 'Backend pipeline failed. Check the console output.'
        }
    }
}
